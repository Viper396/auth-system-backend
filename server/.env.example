# ==============================================================================
# Server Environment Configuration (.env.example)
# Copy this file to .env and provide your actual secrets.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Database Configuration
# Development: Local MongoDB or MongoDB Atlas dev cluster
# Production: Highly available MongoDB Atlas cluster with authentication
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secrets
# Canonical secret names. In production, must be at least 32 characters long.
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be distinct keys.
# Generate secure random keys (e.g. `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_ACCESS_SECRET=your_jwt_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_min_32_chars

# JWT Token Lifetimes & Claims
# Access token expiration: 1m to 1h (default: 15m)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token expiration: 1h to 30d (default: 7d)
JWT_REFRESH_EXPIRES_IN=7d
# Optional token claims validation (issuer and audience)
JWT_ISSUER=
JWT_AUDIENCE=

# Client / Frontend URL & CORS Trusted Origins
# Comma-separated list of origins allowed to access the API with credentials.
# Development: http://localhost:5173
# Production: https://yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=http://localhost:5173

# Cookie Security & Deployment Topology
# COOKIE_SAME_SITE: lax | strict | none (default: lax)
# - "lax": Use for same-site deployments (e.g., app.domain.com and api.domain.com).
# - "strict": Highest restriction (blocks cross-site navigation).
# - "none": Strictly required if frontend and backend reside on different eTLDs (e.g., vercel.app and onrender.com). Requires HTTPS / Secure.
COOKIE_SAME_SITE=lax

# COOKIE_SECURE: true | false (default: true in production or if SameSite=none)
COOKIE_SECURE=false

# COOKIE_DOMAIN: Optional domain scope (e.g., .yourdomain.com for sharing cookies across subdomains)
# Leave blank for default host-only cookie.
COOKIE_DOMAIN=

# Password Reset Token Lifetime (minutes, default: 15)
RESET_TOKEN_EXPIRE_MINUTES=15

# Account Lockout Policy
# Duration in minutes to temporarily lock account after 5 consecutive failed login attempts (default: 15)
ACCOUNT_LOCKOUT_MINUTES=15

# Reverse Proxy Trust (true | false)
# Enable when deployed behind a reverse proxy/load balancer (e.g. AWS ALB, Nginx, Cloudflare, Render)
TRUST_PROXY=false

# Email Service (SMTP) Configuration (Nodemailer)
# Required for password reset emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@example.com
APP_NAME=AuthSystem
