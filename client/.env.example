# ==============================================================================
# Client Environment Configuration (.env.example)
# Copy this file to .env and adjust variables for your environment.
# Vite requires all client-exposed variables to be prefixed with VITE_.
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api
